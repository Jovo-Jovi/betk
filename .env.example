# BETK environment variables — copy to .env.local and fill in values.
# See docs/08-deployment/BETK_CONFIGURATION.md for full descriptions.
# NEVER commit real values.  .env.local is git-ignored.

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── Google OAuth (OD-4) ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Resend (transactional email) ──────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# ── PostHog (product analytics) ───────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ── Sentry (error monitoring) ─────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Supabase Storage buckets ──────────────────────────────────────────────────
SUPABASE_DOCS_BUCKET=
SUPABASE_MEDIA_BUCKET=

# ── WhatsApp (approved-template notifications — R-N02) ────────────────────────
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

# ── SMS (OTP + SLA alerts) ────────────────────────────────────────────────────
SMS_PROVIDER_KEY=

# ── Courier / Bosta (last-mile delivery) ──────────────────────────────────────
BOSTA_API_KEY=
