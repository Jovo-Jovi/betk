# Edge Function secrets for `send-sms-hook` (Phase 02 / T01a).
#
# These are EDGE FUNCTION secrets — they live ONLY in Supabase (set via the
# `supabase secrets set` CLI / dashboard), NOT in the Next.js app env. NEVER
# commit real values. Local dev loads `supabase/functions/.env` automatically on
# `supabase start`; that file is git-ignored.
#
# Copy to `supabase/functions/.env` and fill with real values for local testing.

# Standard Webhooks secret generated by the Supabase Send SMS Hook config.
# MUST keep the `v1,whsec_` prefix; the function strips it before verifying.
SEND_SMS_HOOK_SECRET="v1,whsec_<base64-secret>"

# TorvoSMS REST API.
# Base URL only (the function appends "/sms/send"); e.g. https://smsapi.torvochat.com
TORVOSMS_BASE_URL="https://smsapi.torvochat.com"
# Sent as the `x-api-key` request header.
TORVOSMS_API_KEY="<torvosms-api-key>"
# Approved TorvoSMS sender id.
TORVOSMS_SENDER_ID="<torvosms-sender-id>"
